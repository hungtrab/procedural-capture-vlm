# credentials -- never commit, never print
.env
.hf
.openai
.olp
*.token
**/kaggle.json
**/access_token

# trained adapters: 13G, and run_chain.sh retrains phase A in one VM per arm group.
# Both spellings: on the SLURM port adapters_store is a SYMLINK to FSx, and a pattern
# ending in / matches a directory only, so the symlink showed up as untracked and would
# have been committed -- a machine-specific absolute path, useless to anyone else.
adapters_store
adapters_store/

# scratch and per-run logs
scratchpad/
**/__pycache__/
*.pyc

# the benign demo images and held-out images are rebuilt from the dataset stream on the VM
**/train_imgs/
**/holdout_imgs/

# large intermediate bundles
MIGRATION/
research_handoff/data_samples/*.tar*

# the raw model generations are not published: see README, "What is deliberately not here"
outputs/vlm2_*/
outputs/annotation_*/
outputs/report/*.html
research_handoff/
paper_track/

# round 3 (2026-11-05): raw generations and downloaded benchmark data are not published either
outputs/poc/
outputs/scale/
outputs/scale_smoke*/
data/utility/
data/scale/
meeting/
server_a100/

# round 4 (2026-11-11): the s43/s44 seed replicates are raw generations + venvs +
# worker logs, same policy as outputs/scale/ above -- 2.7G each, not published.
outputs/scale_s4*/

# adapter bundles staged for transfer to FSx (1.4G); the adapters themselves are
# offloaded to /genai/fsx-llm and symlinked back in, see adapters_store above.
adapters_round2.tar
adapters_round2.tar.md5

# editor-local
.vscode/

# M4 (2026-11-14): HarmBench is downloaded, untrusted data (rule 9). Its own directory,
# never committed; the md5 is in the canonical M4 block so the build is reproducible.
data/harmbench_raw/
