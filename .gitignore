# credentials -- never commit, never print
.env
.hf
.openai
.olp
*.token
**/kaggle.json
**/access_token

# trained adapters: 13G, and run_chain.sh retrains phase A in one VM per arm group.
# Both spellings: on the SLURM port adapters_store is a SYMLINK to FSx, and a pattern
# ending in / matches a directory only, so the symlink showed up as untracked and would
# have been committed -- a machine-specific absolute path, useless to anyone else.
adapters_store
adapters_store/

# scratch and per-run logs
scratchpad/
**/__pycache__/
*.pyc

# the benign demo images and held-out images are rebuilt from the dataset stream on the VM
**/train_imgs/
**/holdout_imgs/

# large intermediate bundles
MIGRATION/
research_handoff/data_samples/*.tar*

# the raw model generations are not published: see README, "What is deliberately not here"
outputs/vlm2_*/
outputs/annotation_*/
outputs/report/*.html
research_handoff/
paper_track/

# round 3 (2026-11-05): raw generations and downloaded benchmark data are not published either
outputs/poc/
outputs/scale/
outputs/scale_smoke*/
data/utility/
data/scale/
meeting/
server_a100/

# round 4 (2026-11-11): the s43/s44 seed replicates are raw generations + venvs +
# worker logs, same policy as outputs/scale/ above -- 2.7G each, not published.
outputs/scale_s4*/

# adapter bundles staged for transfer to FSx (1.4G); the adapters themselves are
# offloaded to /genai/fsx-llm and symlinked back in, see adapters_store above.
adapters_round2.tar
adapters_round2.tar.md5

# editor-local
.vscode/

# M4 (2026-11-14): HarmBench is downloaded, untrusted data (rule 9). Its own directory,
# never committed; the md5 is in the canonical M4 block so the build is reproducible.
data/harmbench_raw/

# M2 (2026-11-14): VLGuard is downloaded, untrusted data (rule 9) and 301 MB of images.
# Own directory, never committed; both md5s are in the canonical M2 block.
data/vlguard_raw/

# M6 (2026-11-15): the two transcript bundles from the DRAFT releases. They hold harmful
# generations; next_step is explicit that they are not to be committed and the releases
# are not to be published. md5s are in the M6 block.
new_cells.tgz
seeds4344_cells.tgz

# E5 (2026-11-15): STAR-1 is downloaded, untrusted data (rule 9). Own directory, not
# committed; the parquet md5 is in the canonical E5 block.
data/star1_raw/

# ---------------------------------------------------------------------------------
# 2026-11-16: transcripts matched BY NAME, anywhere in the tree.
#
# Every rule above this point ignores a PATH. That is what failed. The two bundles
# new_cells.tgz / seeds4344_cells.tgz are ignored, but their EXTRACTED contents were
# not, and `outputs/scale/` is anchored at the repo root, so the isolated scoring
# trees -- score/outputs/scale/..., score_m2util/..., score_e3/... -- sat outside
# every pattern. A broad `git add` during a merge resolution swept 308 such paths in:
# 249 MB of raw generations, 95.4% of the AF rows guard-unsafe, staged for a public
# repo. They were caught before any push and stripped from the unpushed history.
#
# A transcript is identifiable by its filename wherever it lives, so match that
# instead of guessing the next directory someone will create.
**/res_*.jsonl
**/san_*.jsonl
moved_rows.jsonl
**/moved_s4*.jsonl

# the extracted bundles and the isolated scoring trees they were read in
/llnm7_s4*/
/lv11_s4*/
/score/
/score_m2util/
/score_e3/
/score_*/

# agent-local state, not research output
.claude/
