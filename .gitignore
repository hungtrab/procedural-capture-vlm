# credentials -- never commit, never print
.env
.hf
.olp
*.token
**/kaggle.json
**/access_token

# trained adapters: 13G, and run_chain.sh retrains phase A in one VM per arm group.
# Both spellings: on the SLURM port adapters_store is a SYMLINK to FSx, and a pattern
# ending in / matches a directory only, so the symlink showed up as untracked and would
# have been committed -- a machine-specific absolute path, useless to anyone else.
adapters_store
adapters_store/

# scratch and per-run logs
scratchpad/
**/__pycache__/
*.pyc

# the benign demo images and held-out images are rebuilt from the dataset stream on the VM
**/train_imgs/
**/holdout_imgs/

# large intermediate bundles
MIGRATION/
research_handoff/data_samples/*.tar*

# the raw model generations are not published: see README, "What is deliberately not here"
outputs/vlm2_*/
outputs/annotation_*/
outputs/report/*.html
research_handoff/
paper_track/
